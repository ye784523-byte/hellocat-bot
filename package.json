{
  "name": "hello-cat",
  "version": "1.0.0",
  "description": "Hello Cat - a cybersecurity CTF, education and community Discord bot.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "NODE_ENV=development node --watch src/index.js",
    "deploy": "node scripts/deploy-commands.js",
    "package:bot-hosting": "node scripts/build-deploy-zip.js",
    "backup": "node scripts/backup.js",
    "validate": "node scripts/validate-data.js",
    "import": "node scripts/import-challenges.js --publish",
    "test": "node --test --test-reporter=spec tests/*.test.js",
    "lint": "find src scripts tests -name '*.js' -exec node --check {} \\;"
  },
  "keywords": [
    "discord",
    "ctf",
    "cybersecurity",
    "bot",
    "education"
  ],
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  }
}
