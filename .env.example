# Hello Cat environment template. Copy to .env and fill in values.
# Never commit .env or any real token/secret.

DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
ADMIN_ROLE_ID=
CHALLENGE_CHANNEL_ID=
LOG_CHANNEL_ID=

# Required for the web terminal: the OAuth2 secret from the Discord developer
# portal. The bot token is never exposed to the browser.
# Developer portal -> your application -> General Information -> Client Secret.
# It is NOT the bot token. Rotating it invalidates the old value.
DISCORD_CLIENT_SECRET=

# The web terminal may use its own Discord application. Set this when the
# OAuth2 application is not the bot application (CLIENT_ID). The redirect URI
# has to be registered on that application.
WEB_CLIENT_ID=

# Required: at least 16 characters, used to HMAC-hash challenge flags.
FLAG_SECRET=

# Optional: signs the web terminal session cookie. Falls back to FLAG_SECRET.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

BOT_PREFIX=!
BOT_TIMEZONE=Africa/Casablanca
NODE_ENV=development

# false = register slash commands to GUILD_ID (fast, recommended in development)
# true  = register slash commands globally (can take up to 1 hour to propagate)
REGISTER_GLOBAL_COMMANDS=false

# Optional storage/log paths (relative to the project root)
DATA_DIR=src/storage/data
LOG_DIR=logs
BACKUP_DIR=backups

# Optional: import ./challenges/*/*.json into the JSON store on startup
CHALLENGE_IMPORT_ON_START=false

# Automated backup interval in hours. Set 0 to disable automatic snapshots.
AUTO_BACKUP_HOURS=24

# ---------------------------------------------------------------- web terminal

# Port and bind address for the web terminal.
WEB_PORT=8080
WEB_HOST=0.0.0.0

# Public URL of the site. The root serves the landing page and /terminal
# serves the application. Used for the Discord OAuth redirect.
WEB_BASE_URL=https://helloc.at
# Must match a redirect URI registered in the Discord developer portal.
# Defaults to WEB_BASE_URL + /auth/callback. Leave empty to derive it from the
# host the browser used (handy with ephemeral ngrok tunnels).
WEB_REDIRECT_URI=

# The official website of the project. It is written in the copyright of the
# landing page and in the footer of every public page.
OFFICIAL_SITE_URL=https://helloc.at

# Invite to the Discord server. Discord is the only supported platform, so
# this link is the main call to action of the site. Defaults to
# https://discord.gg/<GUILD_ID> when GUILD_ID is set.
DISCORD_INVITE_URL=https://discord.gg/your-invite

# Set to true to require Discord server membership before granting access.
WEB_REQUIRE_GUILD=false

# Cookie security: auto (default, per request scheme), true (always Secure) or
# false (never Secure, plain HTTP development only).
WEB_COOKIE_SECURE=auto

# Trust X-Forwarded-Proto from a loopback reverse proxy (nginx) or tunnel
# (ngrok) so HTTPS requests receive Secure cookies.
WEB_TRUST_PROXY=true

# Optional cookie domain. Leave empty for host-only cookies (recommended).
WEB_COOKIE_DOMAIN=

# Session lifetime in seconds (default 12 hours).
WEB_SESSION_TTL=43200

# ------------------------------------------------------- channel assistant

# Public URL of the site the bot links to. Defaults to WEB_BASE_URL.
# The bot links to <WEB_PUBLIC_URL>/terminal for the application.
WEB_PUBLIC_URL=

# Channel for challenge announcements, solve celebrations and the daily tip.
# Falls back to CHALLENGE_CHANNEL_ID when empty.
ANNOUNCEMENT_CHANNEL_ID=

# Announce captures that happen in the web terminal.
ANNOUNCE_SOLVES=true

# How often the bot looks for new captures, in seconds (5-600).
ANNOUNCE_POLL_SECONDS=15

# Post one tip and tricks per day.
DAILY_TIPS_ENABLED=true

# Post the challenge leaderboard to the channel once a week.
WEEKLY_LEADERBOARD_ENABLED=true

# Reply helpfully when an operator asks for help in the channel.
ASSISTANT_ENABLED=true

# Welcome new members and walk them through participating in a challenge.
WELCOME_ENABLED=true

# Send the participation guide as a direct message. When the member has
# direct messages disabled, a greeting is posted in the channel instead.
WELCOME_DM_ENABLED=true

# Optional channel for that public greeting. Falls back to the announcement
# channel and then to the guild system channel.
WELCOME_CHANNEL_ID=
