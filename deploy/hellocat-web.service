[Unit]
Description=Hello Cat Web Terminal
Documentation=https://github.com/hello-cat/hellocatbot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hellocat
Group=hellocat
WorkingDirectory=/opt/hellocatbot
EnvironmentFile=/opt/hellocatbot/.env
ExecStart=/usr/bin/node web/index.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

# The web terminal only needs to read its own directory and write to its data
# folder. It never executes host commands.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/opt/hellocatbot/src/storage/data /opt/hellocatbot/logs /opt/hellocatbot/backups

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hellocat-web

[Install]
WantedBy=multi-user.target
